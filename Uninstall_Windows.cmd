@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "SHAMIGO_LAUNCH_ACTION="
if exist "%~dp0Packages\Windows\ShamiGo_v0.10.394\Tools\Configure_ShamiGo_AutoStart.ps1" goto extracted
set "SHAMIGO_ZIP_CMD=%~f0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:SHAMIGO_ZIP_CMD,[Text.Encoding]::ASCII);$a=$s.LastIndexOf('::SHAMIGO_PS_BEGIN');$b=$s.LastIndexOf('::SHAMIGO_PS_END');if($a -lt 0 -or $b -le $a){exit 2};& ([ScriptBlock]::Create($s.Substring($a+'::SHAMIGO_PS_BEGIN'.Length,$b-$a-'::SHAMIGO_PS_BEGIN'.Length)))"
set "SHAMIGO_RESULT=%ERRORLEVEL%"
if not "%SHAMIGO_RESULT%"=="0" pause
exit /b %SHAMIGO_RESULT%
:extracted
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%~dp0Packages\Windows\ShamiGo_v0.10.394\Tools\Configure_ShamiGo_AutoStart.ps1" -Mode Uninstall
set "SHAMIGO_RESULT=%ERRORLEVEL%"
if not "%SHAMIGO_RESULT%"=="0" pause
exit /b %SHAMIGO_RESULT%
::SHAMIGO_PS_BEGIN
# ShamiGo v394: standalone ZIP/Explorer CMD runtime, source for embedded PowerShell.
# This runs only when Explorer has staged the selected CMD without dependencies.
# The pinned payload is a read-only snapshot generated by build_cmd_entrypoints.py.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$mode = 'uninstall'
$payloadDigest = '4cce19ca56bd06af80ab31e7c9c0b1d04d8439849684d014e103eb84ee91c008'
$appDigest = '2d2f0a73b06816080f8275c1304157f9cf7c1cf9f3a279a352f1118fd1af4373'
$setupDigest = '246729bcc5974a5f20fb5cc91ed725e6e57cafc384a3c5f7aa30b900972cb4fe'
$launcherDigest = 'b3b2e31f88b189123e5a6270c233a396f3c42bba932f02a63a93d23e077229ef'
$version = '0.10.394'
$stage = $null
$exitCode = 1
try {
    $self = $env:SHAMIGO_ZIP_CMD
    if ([string]::IsNullOrWhiteSpace($self) -or -not [IO.File]::Exists($self)) {
        throw 'Cannot find the CMD launcher.'
    }
    $raw = [IO.File]::ReadAllText($self, [Text.Encoding]::ASCII)
    $startTag = '::SHAMIGO_PAYLOAD_BEGIN'
    $endTag = '::SHAMIGO_PAYLOAD_END'
    $a = $raw.LastIndexOf($startTag, [StringComparison]::Ordinal)
    $b = $raw.LastIndexOf($endTag, [StringComparison]::Ordinal)
    if ($a -lt 0 -or $b -le $a) { throw 'Embedded payload markers are missing.' }
    $encoded = $raw.Substring($a + $startTag.Length, $b - $a - $startTag.Length).Trim()
    if ($encoded.Length -lt 100 -or $encoded.Length -gt 16000000) {
        throw 'Embedded payload size is unexpected.'
    }
    $packageBytes = [Convert]::FromBase64String($encoded)
    $sha = [Security.Cryptography.SHA256]::Create()
    try {
        $actualDigest = [BitConverter]::ToString($sha.ComputeHash($packageBytes)).Replace('-', '').ToLowerInvariant()
    } finally { $sha.Dispose() }
    if ($actualDigest -cne $payloadDigest) { throw 'Embedded package SHA-256 mismatch.' }

    # A fresh random child of the Windows user's own TEMP, removed in finally.
    $stage = Join-Path ([IO.Path]::GetTempPath()) ('ShamiGo-v394-' + [guid]::NewGuid().ToString('N'))
    [IO.Directory]::CreateDirectory($stage) | Out-Null
    $archivePath = Join-Path $stage 'payload.zip'
    [IO.File]::WriteAllBytes($archivePath, $packageBytes)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $archive = [IO.Compression.ZipFile]::OpenRead($archivePath)
    try {
        $seen = @{}
        $total = [int64]0
        $count = 0
        $manifestName = '__SHAMIGO_EMBEDDED_SHA256.txt'
        # Derive allowed Windows paths from the same release version as the
        # actual embedded files. Do not hardcode a previous version here.
        $winPrefix = 'Packages/Windows/ShamiGo_v' + $version + '/'
        $linuxPrefix = 'Packages/Linux/'
        foreach ($entry in $archive.Entries) {
            $name = [string]$entry.FullName
            $count++
            $isKnownPath = ($name -ceq $manifestName) -or
                $name.StartsWith($winPrefix, [StringComparison]::Ordinal) -or
                $name.StartsWith($linuxPrefix, [StringComparison]::Ordinal)
            if ($count -gt 120 -or $name -eq '' -or $name.EndsWith('/') -or
                $name.Contains('\') -or $name.Contains(':') -or $name.StartsWith('/') -or
                $name.Contains('//') -or $name -match '(^|/)\.{1,2}(/|$)' -or
                -not $isKnownPath) {
                throw ('Unsafe or unexpected ZIP member: ' + $name)
            }
            if ($seen.ContainsKey($name)) { throw 'Duplicate ZIP member.' }
            $seen[$name] = $true
            if ((($entry.ExternalAttributes -shr 16) -band 0xF000) -eq 0xA000) {
                throw 'ZIP symbolic link is forbidden.'
            }
            $total += [int64]$entry.Length
            if ($total -gt 67108864) { throw 'ZIP uncompressed size limit exceeded.' }
        }
        if ($count -lt 2 -or -not $seen.ContainsKey($manifestName)) {
            throw 'ZIP payload file manifest is missing.'
        }
    } finally { $archive.Dispose() }
    [IO.Compression.ZipFile]::ExtractToDirectory($archivePath, $stage)
    $listPath = Join-Path $stage '__SHAMIGO_EMBEDDED_SHA256.txt'
    $verified = @{}
    foreach ($line in [IO.File]::ReadAllLines($listPath)) {
        # The ZIP inventory was already checked against $winPrefix and
        # $linuxPrefix, and every manifest name must match an actual member.
        if ($line -cnotmatch '^([0-9a-f]{64})  (Packages/[^\r\n]+)$') {
            throw 'Invalid embedded file checksum entry.'
        }
        $digest = $Matches[1]
        $name = $Matches[2]
        if (-not $seen.ContainsKey($name) -or $verified.ContainsKey($name)) {
            throw 'Missing or repeated embedded file checksum.'
        }
        $verified[$name] = $true
        $file = Join-Path $stage ($name.Replace('/', '\'))
        if (-not [IO.File]::Exists($file)) { throw 'Missing extracted file.' }
        if ((Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash -ine $digest) {
            throw ('Extracted file checksum mismatch: ' + $name)
        }
    }
    if ($verified.Count -ne ($seen.Count - 1)) { throw 'Incomplete embedded file inventory.' }

    $release = Join-Path $stage ('Packages\Windows\ShamiGo_v' + $version)
    $manager = Join-Path $stage 'Packages\Linux\ShamiGo_VM_Manager.ps1'
    $config = Join-Path $release 'Tools\Configure_ShamiGo_AutoStart.ps1'
    $app = Join-Path $release ('ShamiGo_v' + $version + '.exe')
    $setup = Join-Path $release 'ShamiGo_AdminSetup.exe'
    $launcher = Join-Path $release 'ShamiGo_AdminLauncher.exe'
    # Never pretend that a public ZIP contains a privately licensed table.
    # Extract the public archive first, add a legally held table, and use its
    # regular launcher. The private developer ZIP already contains this table.
    $table = Join-Path $release 'LicensedTables\liu-uni.tab'
    if ($mode -in @('run','run-admin','run-elevated','install') -and
        -not [IO.File]::Exists($table)) {
        throw 'Missing personal Liu table. Extract the full ZIP, put your own licensed liu-uni.tab in Packages\Windows\ShamiGo_v0.10.394\LicensedTables, and run the root CMD again.'
    }
    if ($mode -eq 'install' -or $mode -eq 'uninstall') {
        if (-not [IO.File]::Exists($config)) { throw 'Missing Windows administration PowerShell script.' }
        $action = if ($mode -eq 'uninstall') { 'Uninstall' } elseif ($env:SHAMIGO_LAUNCH_ACTION -eq 'Disable') { 'Disable' } else { 'Install' }
        Write-Host ('ShamiGo v' + $version + ' - ' + $action)
        & powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File $config -Mode $action
        $exitCode = [int]$LASTEXITCODE
    } elseif ($mode -eq 'vm') {
        if (-not [IO.File]::Exists($manager)) { throw 'Missing Linux VM PowerShell manager.' }
        & powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File $manager -Action menu
        $exitCode = [int]$LASTEXITCODE
    } elseif ($mode -eq 'run' -or $mode -eq 'run-admin') {
        if (-not [IO.File]::Exists($app) -or -not [IO.File]::Exists($setup) -or -not [IO.File]::Exists($launcher)) {
            throw 'Missing portable ShamiGo executables.'
        }
        # The app continues after the CMD exits, so keeping its resources in a
        # per-user portable directory is necessary. This is NOT installer TEMP.
        $cache = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) ('ShamiGo\ZipPortable\v' + $version)
        $cacheParent = Split-Path -Parent $cache
        if (-not [IO.Directory]::Exists($cache)) {
            [IO.Directory]::CreateDirectory($cacheParent) | Out-Null
            Move-Item -LiteralPath $release -Destination $cache -ErrorAction Stop
        }
        # Validate shipped executables without touching portable user settings.
        foreach ($nameToCheck in @(('ShamiGo_v' + $version + '.exe'),'ShamiGo_AdminSetup.exe','ShamiGo_AdminLauncher.exe')) {
            $expectedHash = if ($nameToCheck -eq ('ShamiGo_v' + $version + '.exe')) {
                $appDigest
            } elseif ($nameToCheck -eq 'ShamiGo_AdminSetup.exe') {
                $setupDigest
            } else { $launcherDigest }
            $binary = Join-Path $cache $nameToCheck
            if (-not [IO.File]::Exists($binary) -or
                (Get-FileHash -LiteralPath $binary -Algorithm SHA256).Hash -ine $expectedHash) {
                throw ('Portable cache executable differs from the official v' + $version + ' package: ' + $binary)
            }
        }
        $name = if ($mode -eq 'run-admin') { 'ShamiGo_AdminLauncher.exe' } else { 'ShamiGo_v' + $version + '.exe' }
        $exe = Join-Path $cache $name
        $null = Start-Process -FilePath $exe -WorkingDirectory $cache -PassThru -ErrorAction Stop
        Write-Host ('Portable ShamiGo started from ' + $cache)
        $exitCode = 0
    } elseif ($mode -eq 'run-elevated') {
        if (-not [IO.File]::Exists($setup)) { throw 'Missing Windows elevated setup executable.' }
        $process = Start-Process -FilePath $setup -Verb RunAs -WorkingDirectory $release -PassThru -ErrorAction Stop
        try {
            $process.WaitForExit()
            $exitCode = [int]$process.ExitCode
        } finally { $process.Dispose() }
    } else {
        throw 'Unsupported standalone CMD action.'
    }
} catch {
    Write-Host ('ERROR: ' + $_.Exception.Message)
    $exitCode = 1
} finally {
    if ($null -ne $stage -and [IO.Directory]::Exists($stage)) {
        try { Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction Stop }
        catch {
            Write-Host ('WARNING: Could not clean ZIP launcher temporary files: ' + $stage)
            if ($exitCode -eq 0) { $exitCode = 3 }
        }
    }
}
exit $exitCode
::SHAMIGO_PS_END
